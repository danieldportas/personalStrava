# Credenciales de tu app de Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=267555
STRAVA_CLIENT_SECRET=4928f08eaa52b8d8b6e094797aee45a3b16d7582

# Debe coincidir EXACTAMENTE con el "Authorization Callback Domain" configurado en Strava.
# En local con un tunel (ngrok, cloudflared, expo tunnel, etc.) usa la URL publica del tunel + /api/auth/strava/callback
STRAVA_REDIRECT_URI=http://localhost:4000/api/auth/strava/callback

# Esquema de deep link registrado en la app movil (ver mobile/app.json -> "scheme")
MOBILE_APP_SCHEME=personalstrava

# Puerto del servidor
PORT=4000

# Ruta del fichero JSON usado como almacen de datos (se crea solo si no existe)
DATA_FILE=./data/db.json
